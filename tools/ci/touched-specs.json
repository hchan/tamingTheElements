{
  "schema": 1,
  "noE2e": [
    "docs/**",
    "ideas/**",
    "**/*.md",
    ".claude/**",
    ".github/**",
    "tools/assets/**",
    "tools/gpu-queue/**",
    "tools/ci/long-gate-status.json",
    "tools/ci/e2e-durations.json",
    "tests/{repo,sim,legacy,lint,oracle,browser,visual}/**",
    "tests/fixtures/{ai,balance,rigs}/**",
    "**/*.test.ts",
    "src/testing/legacy/**"
  ],
  "infra": [
    "playwright*.config.ts",
    "tools/ci/e2e-server.ts",
    "tools/ci/e2e-port.ts",
    "tools/ci/browser-slot.ts",
    "package.json",
    "pnpm-lock.yaml",
    "vite.config.ts",
    "tsconfig*.json",
    "index.html",
    "src/game/app/{flow,main,lazy-screen,game-handle,notice-banner,download}.ts",
    "src/game/boot/{phaser-config,presentation,webgl-check,error-screen}.ts",
    "src/game/loop/**",
    "src/game/platform/{test-hook,flags}.ts",
    "src/ui/{router,dom}.ts"
  ],
  "areas": [
    {"area":"core","globs":["src/core/**"],"specs":["smoke.spec.ts","parity/golden-paths.spec.ts","arena-smoke.spec.ts","arcade.spec.ts","tour-fight-match.spec.ts"]},
    {"area":"net","globs":["src/game/net/**","src/testing/net/**","src/game/app/online-*.ts","src/ui/styles/online-screen.css"],"specs":["online-versus.spec.ts","webrtc-peer.spec.ts","online-relay.spec.ts","online-leave.spec.ts","online-copy-paste.spec.ts","online-quick.spec.ts","online-mobile.spec.ts","online-match.spec.ts"]},
    {"area":"arcade-app","globs":["src/game/app/arcade-*.ts","src/ui/screens/arcade-versus.ts","src/game/platform/arcade-setting.ts"],"specs":["arcade.spec.ts","arcade-local.spec.ts"]},
    {"area":"tour","globs":["src/game/app/tour*.ts","src/ui/screens/tour*.ts","src/ui/styles/tour-pick.css"],"specs":["tour.spec.ts","tour-card.spec.ts","tour-fight-match.spec.ts","tour-win.spec.ts"]},
    {"area":"touch","globs":["src/game/app/touch-*.ts","src/game/hud/touch-overlay.ts","src/game/platform/a11y/touch-layout.ts","src/ui/styles/touch-strike-gutter.css"],"specs":["touch-stick.spec.ts","touch-fight-layout.spec.ts","a11y-trap-touch.spec.ts"]},
    {"area":"replay","globs":["src/game/replay/**","src/game/app/{replay-viewer,input-display}.ts","src/game/platform/storage/replay-store.ts","src/game/platform/record-setting.ts"],"specs":["playtest-replay.spec.ts","replay-input-display.spec.ts","parity/golden-paths.spec.ts"]},
    {"area":"viewport","globs":["src/game/boot/viewport.ts","src/ui/display-scale.ts"],"specs":["responsive.spec.ts","display-size.spec.ts","small-viewport-fight.spec.ts"]},
    {"area":"styles","globs":["src/ui/styles/**"],"specs":["responsive.spec.ts","phone-layout.spec.ts","small-viewport-fight.spec.ts","menu-phone-row.spec.ts","layout-r15.spec.ts"],"narrow":"stem"},
    {"area":"hud","globs":["src/game/hud/**","src/game/scenes/Hud.ts","src/ui/element-marks.ts"],"specs":["hud-labels-sf.spec.ts","life-readout.spec.ts","hud-text-clear.spec.ts","super-band.spec.ts","super-band-portrait.spec.ts","phone-chips.spec.ts","hud-polish-r77.spec.ts","status-more-chip.spec.ts","action-bar-groups.spec.ts","action-bar-kits-shot.spec.ts","ghost-bar-shot.spec.ts","classic-bar-inset.spec.ts","callout-pop-lanes.spec.ts","slot-tooltip.spec.ts","element-marks.spec.ts"]},
    {"area":"input","globs":["src/game/input/**","src/game/platform/input/**","src/ui/keyboard.ts","src/ui/screens/{key-bindings,pad-bindings-section}.ts"],"specs":["keyboard.spec.ts","touch-stick.spec.ts","pad-deadzone.spec.ts","touch-fight-layout.spec.ts","move-backward.spec.ts"]},
    {"area":"screens","globs":["src/ui/screens/**","src/ui/{subline,version}.ts"],"specs":["versus-abilities.spec.ts","versus-desktop-grid.spec.ts","versus-hero-pick.spec.ts","versus-layout.spec.ts","versus-portrait-grid.spec.ts","versus-stage-pick.spec.ts","settings-save.spec.ts","settings-sections.spec.ts","help-controls.spec.ts","picker-bar.spec.ts","hero-picker-layout.spec.ts","app-flow.spec.ts","guide.spec.ts","hero-drag.spec.ts","hero-unselect.spec.ts","picker-rows-reachable.spec.ts","menu-showcase.spec.ts","phone-portrait-menu.spec.ts"],"narrow":"stem"},
    {"area":"scenes","globs":["src/game/scenes/**"],"specs":["arena-smoke.spec.ts","battle-teardown.spec.ts","battle-failures.spec.ts","match-end.spec.ts","round-end-panel.spec.ts","round-result.spec.ts","round-result-real-fight.spec.ts"]},
    {"area":"fx","globs":["src/game/fx/**"],"specs":["ability-fx.spec.ts","signature-fx.spec.ts","status-fx.spec.ts","cc-fx.spec.ts","own-element-fx.spec.ts","cleanse-fx.spec.ts","ice-shock-fx.spec.ts","ko-fx-shot.spec.ts","hit-mark-element.spec.ts","hit-juice-shot.spec.ts","hit-feel-capture.spec.ts","sf-juice-shot.spec.ts","fire-blast-fade-shot.spec.ts","super-impact-shot.spec.ts","fx-map-sprites.spec.ts","cast-tint.spec.ts","trap-art.spec.ts"],"narrow":"stem"},
    {"area":"stage","globs":["src/game/fx/{danger-*,hazard-view,stage-ambient*,terrain-*,weather-*}.ts","src/game/views/{backdrop,void-stage}.ts"],"specs":["stage-ambient.spec.ts","stage-hazards.spec.ts","danger-zone.spec.ts","terrain-chips-water.spec.ts","arcade-stage-floors.spec.ts","arcade-terrain.spec.ts","weather-particles.spec.ts","arcade-weather.spec.ts","floor-backgrounds.spec.ts"]},
    {"area":"a11y","globs":["src/game/a11y/**","src/game/platform/a11y/**"],"specs":["a11y.spec.ts","a11y-features.spec.ts","a11y-focus.spec.ts","a11y-trap-touch.spec.ts"]},
    {"area":"pause","globs":["src/game/a11y/pause-dialog.ts"],"specs":["pause-menu.spec.ts","pause-reasons.spec.ts"]},
    {"area":"audio","globs":["src/game/audio/**","src/game/platform/volume-setting.ts"],"specs":["audio-mute.spec.ts","sfx-wiring.spec.ts","arcade-audio.spec.ts"]},
    {"area":"cine","globs":["src/game/cine/**","src/game/cinematics/**","src/game/scenes/Cinematic.ts","src/game/fx/super-cinematic.ts"],"specs":["cinematic-keys.spec.ts","cinematic-teardown.spec.ts"]},
    {"area":"tester","globs":["src/ui/tester/**","src/game/platform/tester/**","src/ui/styles/tester-panel.css"],"specs":["tester-mode.spec.ts"]},
    {"area":"platform","globs":["src/game/platform/**"],"specs":["display-size.spec.ts","storage-guards.spec.ts","settings-save.spec.ts"]},
    {"area":"views","globs":["src/game/views/**"],"specs":["sprite-sheets.spec.ts","hero-scale.spec.ts","pseudo3d-depth.spec.ts","pseudo3d-orbit.spec.ts","pseudo3d-rope.spec.ts","idle-aura.spec.ts","idle-aura-menu.spec.ts","idle-motif.spec.ts","move-wings-knees.spec.ts","smooth-movement.spec.ts"],"narrow":"stem"},
    {"area":"assets","globs":["src/game/assets/**","public/assets/**","tools/assets/png-lite.ts"],"specs":["sprite-sheets.spec.ts","hero-scale.spec.ts","effect-sprites-shot.spec.ts","floor-backgrounds.spec.ts","elemental-heroes-shot.spec.ts","roster24-shot.spec.ts","hero-portrait-shot.spec.ts"]},
    {"area":"loop","globs":["src/game/loop/**"],"specs":["perf.spec.ts","arena-smoke.spec.ts","smooth-movement.spec.ts"]},
    {"area":"relay-tool","globs":["tools/signal-relay/**"],"specs":["online-relay.spec.ts"]}
  ],
  "broadAlways": ["parity/golden-paths.spec.ts"],
  "broadCapSec": 650,
  "budgetSec": 1200,
  "maxTests": 150
}
