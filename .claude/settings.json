{
  "permissions": {
    "deny": [
      "Read(war/WEB-INF/user.properties)",
      "Read(./**/.env*)",
      "Bash(rm -rf /*)",
      "Bash(curl*|*sh)"
    ],
    "allow": [
      "Bash(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-local-ci.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-handoff.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
