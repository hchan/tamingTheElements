{
  "name": "taming-the-elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project core --project repo",
    "test:coverage": "vitest run --project core --project dom --coverage",
    "sbom": "sh tools/sbom/sbom.sh",
    "test:legacy": "vitest run --project legacy",
    "test:oracle": "vitest run --project oracle",
    "oracle:restore": "tsx tools/oracle/restore.ts",
    "test:dom": "vitest run --project dom",
    "test:browser": "tsx tools/ci/browser-slot.ts -- vitest run --project browser",
    "e2e:smoke": "tsx tools/ci/e2e-route.ts smoke",
    "e2e": "tsx tools/ci/e2e-route.ts run",
    "pc:probe": "tsx tools/ci/pc-probe.ts",
    "e2e:remote": "tsx tools/ci/e2e-route.ts run --pc",
    "e2e:local": "tsx tools/ci/e2e-route.ts run --local",
    "visual:capture": "tsx tools/ci/browser-slot.ts -- tsx tools/visual/run.ts capture",
    "visual:abilities": "tsx tools/ci/browser-slot.ts -- tsx tools/visual/run.ts abilities",
    "visual:pacing": "tsx tools/ci/browser-slot.ts -- tsx tools/visual/run.ts pacing",
    "visual:regress": "tsx tools/ci/browser-slot.ts -- tsx tools/visual/run.ts regress",
    "visual:update": "tsx tools/ci/browser-slot.ts -- tsx tools/visual/run.ts update",
    "e2e:pages": "tsx tools/ci/e2e-route.ts pages",
    "build:itch": "node tools/itch/build-itch.mjs",
    "online:measure": "tsx --tsconfig tsconfig.app.json tools/online-measure.ts",
    "ai:duel": "tsx tools/sim/ai-duel.ts",
    "ai:summary": "tsx tools/sim/ai-variety-summary.ts",
    "ai:stalemates": "tsx tools/sim/stalemate-probe.ts",
    "ai:wallpin": "tsx tools/sim/wall-pin-probe.ts",
    "size:check": "tsx tools/ci/size-check.ts",
    "relay": "tsx tools/signal-relay/server.ts",
    "soak:webrtc": "tsx tools/ci/browser-slot.ts -- tsx tools/ci/webrtc-soak.ts",
    "e2e:flake": "tsx tools/ci/e2e-route.ts flake",
    "ci:local": "tsx tools/ci/local-ci.ts",
    "deploy:pages": "tsx tools/ci/deploy-pages.ts",
    "e2e:itch": "tsx tools/ci/e2e-route.ts itch",
    "docs:gen": "tsx tools/gen/gen-design-tables.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "golden:record": "tsx tools/gen/record-golden.ts",
    "sim:match": "tsx tools/sim/run-match.ts",
    "fun:report": "tsx tools/sim/fun-report.ts",
    "fun:gates": "tsx tools/ci/fun-gates.ts",
    "fun:noise": "tsx tools/ci/fun-noise.ts",
    "range:probe": "tsx tools/sim/range-probe.ts",
    "ability:usage": "tsx tools/sim/ability-usage.ts",
    "ability:gates": "tsx tools/ci/ability-usage-gates.ts",
    "sim:net": "tsx tools/sim/run-net.ts",
    "replay:verify": "tsx tools/replay-verify.ts",
    "balance:compare": "tsx tools/sim/balance.ts",
    "balance:record": "tsx tools/sim/balance.ts --record",
    "assets:build": "tsx tools/assets/build-assets.ts",
    "assets:sheets": "tsx tools/assets/pack-sheets.ts",
    "assets:bake": "tsx tools/assets/bake-rig.ts",
    "format": "echo \"not yet\" && exit 1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.2",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "ws": "8.22.2"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "phaser": "4.2.1",
    "valibot": "^1.5.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.1"
    }
  }
}
