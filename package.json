{
  "name": "taming-the-elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project core --project repo",
    "test:coverage": "vitest run --project core --coverage",
    "sbom": "sh tools/sbom/sbom.sh",
    "test:legacy": "vitest run --project legacy",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "visual:capture": "tsx tools/visual/run.ts capture",
    "visual:pacing": "tsx tools/visual/run.ts pacing",
    "visual:regress": "tsx tools/visual/run.ts regress",
    "visual:update": "tsx tools/visual/run.ts update",
    "e2e:pages": "playwright test --config playwright.pages.config.ts",
    "build:itch": "node tools/itch/build-itch.mjs",
    "size:check": "tsx tools/ci/size-check.ts",
    "ci:local": "tsx tools/ci/local-ci.ts",
    "deploy:pages": "tsx tools/ci/deploy-pages.ts",
    "e2e:itch": "playwright test --config playwright.itch.config.ts",
    "docs:gen": "tsx tools/gen/gen-design-tables.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "golden:record": "tsx tools/gen/record-golden.ts",
    "sim:match": "tsx tools/sim/run-match.ts",
    "sim:net": "tsx tools/sim/run-net.ts",
    "replay:verify": "tsx tools/replay-verify.ts",
    "balance:compare": "tsx tools/sim/balance.ts",
    "balance:record": "tsx tools/sim/balance.ts --record",
    "assets:build": "tsx tools/assets/build-assets.ts",
    "format": "echo \"not yet\" && exit 1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cyclonedx/cyclonedx-npm": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "phaser": "4.2.1",
    "valibot": "^1.5.0"
  }
}
