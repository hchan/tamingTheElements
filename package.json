  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project core --project repo",
    "test:legacy": "vitest run --project legacy",
    "test:browser": "echo \"not yet\" && exit 1",
    "e2e": "playwright test",
    "docs:gen": "tsx tools/gen/gen-design-tables.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "golden:record": "tsx tools/gen/record-golden.ts",
    "sim:match": "echo \"not yet\" && exit 1",
    "assets:build": "tsx tools/assets/build-assets.ts",
    "format": "echo \"not yet\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
