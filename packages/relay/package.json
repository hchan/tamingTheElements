  "description": "Transport-agnostic relay core for the Taming the Elements online protocol (wire codec, RelayCore, store and sender seams) and a framework-agnostic wire-spec conformance suite.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "private": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
    "./conformance": { "types": "./dist/conformance.d.ts", "default": "./dist/conformance.js" },
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20" }
}
